    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.21.0",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
