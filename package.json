    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:update-trend": "node scripts/update-coverage-trend.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "build": "tsc",
    "migrate": "node dist/migrate-cli.js",
    "seed": "node dist/seed-cli.js",
    "docker:build": "docker compose build",
    "docker:run": "node scripts/docker-run.js"
  },
  "repository": {
    "type": "git",
    "url": "github.com/hardytool/server"
  },
  "author": "@dambrisco",
  "license": "ISC",
  "dependencies": {
    "@json2csv/plainjs": "^7.0.8",
    "bignumber.js": "^11.1.5",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "edmonds-blossom": "^1.0.0",
    "express": "^5.0.0",
    "express-session": "^1.19.0",
    "got": "^15.1.0",
    "helmet": "^8.3.0",
    "markdown-it": "^15.0.1",
    "markdown-it-classy": "^0.2.0",
    "nanoid": "^6.0.1",
    "passport": "^0.7.0",
    "passport-steam": "^1.0.18",
    "pg": "^8.23.0",
    "pg-sql": "^1.1.0",
    "pug": "^3.0.4",
    "pug-tree": "^1.0.4",
    "swiss-pairing": "^1.4.3"
