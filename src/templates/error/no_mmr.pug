extends ../components/base.pug

block title
  title #{title} : Must have MMR

block content
  div.columns
    div.column
      h3.title.is-3.has-icon
        span.icon.is-medium
          i.fa.fa-exclamation-triangle
        span Must have MMR
  div.columns
    div.column
      if error
        span= error
      else
        div You must have MMR to be eligible for self-registration.
        div If you've just recently calibrated, please try again later.
        div If you do not have MMR, please contact a division admin for assistance with registration.
